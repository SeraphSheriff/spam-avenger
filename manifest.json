{
  "manifest_version": 3,
  "name": "Spam Avenger for Thunderbird",
  "version": "1.0.74",
  "description": "Trace who really sent a spam email and draft the abuse complaint in one click. Free, no account — just click, review, send.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "spam-avenger-thunderbird@seraphsheriff.github.io",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage",
    "messagesRead",
    "accountsRead",
    "compose",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://rdap.arin.net/*",
    "https://rdap.db.ripe.net/*",
    "https://rdap.apnic.net/*",
    "https://rdap.lacnic.net/*",
    "https://rdap.afrinic.net/*",
    "https://dns.google/*",
    "https://safebrowsing.google.com/*",
    "https://reportfraud.ftc.gov/*",
    "https://data.iana.org/*",
    "https://rdap.org/*",
    "https://crt.sh/*",
    "https://support.google.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "message_display_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Spam Avenger for Thunderbird"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": ["reportfill.js"],
      "matches": [
        "https://safebrowsing.google.com/*",
        "https://reportfraud.ftc.gov/*",
        "https://support.google.com/*"
      ],
      "run_at": "document_idle"
    }
  ]
}
